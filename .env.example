APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Один файл на день: storage/logs/laravel-YYYY-MM-DD.log (легше шукати помилки при синках)
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# МойСклад JSON API (основний синк — Basic)
# MOY_SKLAD_USERNAME=
# MOY_SKLAD_PASSWORD=
# Bearer API МойСклад + тест роута /moysklad/bearer-sync-one-product
# MOY_SKLAD_TOKEN=
# ID товару в БД для синку без product_id в URL (напр. 333):
# MOY_SKLAD_BEARER_TEST_PRODUCT_ID=
# Секрет доступу до роута (або SCHEDULER_TOKEN): ?token= або заголовок X-Moysklad-Sync-Token
# MOY_SKLAD_BEARER_SYNC_SECRET=
# ping: GET /moysklad/bearer-sync-one-product?ping=1 — лише перевірка з’єднання з МС
#
# Обмеження навантаження на Remap API (ціни/залишки): пауза між запитами, ретраї 429
# MOY_SKLAD_REMAP_DELAY_MS=120
# MOY_SKLAD_REMAP_TIMEOUT=90
# MOY_SKLAD_429_MAX_RETRIES=8
# MOY_SKLAD_429_BACKOFF_BASE=3

# Scout / Algolia (поиск)
# SCOUT_DRIVER=algolia
# ALGOLIA_APP_ID=
# ALGOLIA_SECRET=
# Скільки hits з Algolia для пошуку (1–50)
# ALGOLIA_SEARCH_MAX_HITS=50
# Допуск опечаток Algolia: strict (менше сторонніх товарів у видачі) | min | true | false
# ALGOLIA_SEARCH_TYPO_TOLERANCE=strict
# Префикс индекса: локально задай, чтобы не трогать прод (например local_ или dev_)
# SCOUT_PREFIX=local_

# Cron без SSH: на хості ДВА виклики кожну хв (той самий SCHEDULER_TOKEN):
# 1) https://ваш-сайт/run-scheduler?token=...  — Laravel schedule (синки з routes/console.php)
# 2) https://ваш-сайт/run-queue?token=...     — обробка черги (database/redis), без SSH
# SCHEDULER_TOKEN=придумайте_секретний_рядок
# QUEUE_CONNECTION=database
# Необов’язково для /run-queue: ліміт часу одного прогону (сек.) і джоб за прогін (0 = без ліміту джоб)
# QUEUE_WORK_MAX_TIME=55
# QUEUE_WORK_MAX_JOBS=0
# Повне оновлення товарів з МС (неділя 01:00): верхня межа offset у МойСклад (усі товари). Потрібен queue:work.
# SCHEDULE_PRODUCTS_FULL_SYNC_END=15000
# Розмір батчу для джоб цін/залишків (щодня + ручний синк з адмінки при limit=0; джоби йдуть ланцюжком)
# SCHEDULE_PRICE_SYNC_BATCH=100
