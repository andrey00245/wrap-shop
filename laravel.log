72100109a11","name":"Бренд","value":"Oracal"},{"id":"a8241b25-1f3b-11ee-0a80-062200399427","name":"Серія","value":"Oracal 970"},{"id":"2e9c4fd4-1f24-11ee-0a80-13d90035bbfd","name":"Застосування","value":"Ця плівка підходить для автостайлінгу та зовнішнього тюнінгу транспортних засобів, нанесення рекламної графіки та брендування авто, повної та часткової обклейки автомобілів, довгострокової зовнішньої реклами, а також використання на яхтах, катерах і човнах."},{"id":"2e9c510d-1f24-11ee-0a80-13d90035bbfe","name":"Переваги","value":"Глибокий суперматовий чорний Black Super Matt: преміальний колір без відблисків для стильного та виразного вигляду авто.
Еластичність і міцність: легко наноситься на рівні, рельєфні та увігнуті поверхні, заклепки та шви.
Стійкість і довговічність: захищає від ультрафіолету, вигорання, води та хімічних впливів, підходить для морського транспорту.
Ідеальна для автостайлінгу, тюнінгу, брендування та обклеювання повністю або частково, включно зі стійками дверей."},{"id":"7e95b81a-9342-11ed-0a80-072100109a12","name":"Призначення","value":"декоративна"},{"id":"7e95b9db-9342-11ed-0a80-072100109a14","name":"Матеріал","value":"ПВХ"},{"id":"7e95baee-9342-11ed-0a80-072100109a15","name":"Структура","value":"матова"},{"id":"a15a8448-3c12-11ee-0a80-004e000997a3","name":"Основний відтінок","value":{"meta":{"href":"https://api.moysklad.ru/api/remap/1.2/entity/customentity/eae1d0d2-3c10-11ee-0a80-004e000930b1/140a8f0e-3c12-11ee-0a80-0fd60006590d","metadataHref":"https://api.moysklad.ru/api/remap/1.2/context/companysettings/metadata/customEntities/eae1d0d2-3c10-11ee-0a80-004e000930b1","type":"customentity","mediaType":"application/json","uuidHref":"https://online.moysklad.ru/app/#custom_eae1d0d2-3c10-11ee-0a80-004e000930b1/edit?id=140a8f0e-3c12-11ee-0a80-0fd60006590d"},"name":"чорний"}},{"id":"7e95bc68-9342-11ed-0a80-072100109a17","name":"Рулон, м.п.","value":"25"},{"id":"7e95bd25-9342-11ed-0a80-072100109a18","name":"Ширина, м","value":"1,52"},{"id":"7e95be86-9342-11ed-0a80-072100109a1a","name":"Товщина","value":"110 мкм"},{"id":"7e95bfe7-9342-11ed-0a80-072100109a1c","name":"Спосіб нанесення","value":"сухий"},{"id":"7e95c0b5-9342-11ed-0a80-072100109a1d","name":"Розтягування матеріалу, %","value":120},{"id":"7e95c17a-9342-11ed-0a80-072100109a1e","name":"Protective Liner","value":"ні"},{"id":"7e95c231-9342-11ed-0a80-072100109a1f","name":"Температура поверхні","value":"від +18°C до +22°C"},{"id":"7e95c619-9342-11ed-0a80-072100109a22","name":"Необхідність нагріву","value":"так"},{"id":"7e95c75f-9342-11ed-0a80-072100109a23","name":"Температура експлуатації","value":"від -60°C до +120°C"},{"id":"2e9c4c13-1f24-11ee-0a80-13d90035bbfc","name":"Температура приміщення","value":"від 15"},{"id":"65010efd-1f22-11ee-0a80-03a0003652cb","name":"Кваліфікація майстра","value":{"meta":{"href":"https://api.moysklad.ru/api/remap/1.2/entity/custom